<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Counterpick.App</RootNamespace>
    <AssemblyName>Counterpick</AssemblyName>
    <!-- Bumped by tools/release.ps1; Velopack compares this to decide what is an update. -->
    <Version>1.0.1</Version>
    <!-- Program.cs replaces the Main that App.xaml would generate; see the note there. -->
    <StartupObject>Counterpick.App.Program</StartupObject>
    <!-- English only; WPF would otherwise publish a dozen locale folders nobody reads. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      Where the installed app looks for newer versions. tools/release.ps1 passes the
      folder it packs into, so a release knows where its successors will be.
    -->
    <UpdateSource Condition="'$(UpdateSource)' == ''"></UpdateSource>
    <!-- The exe's icon: Explorer, the taskbar and the title bar pick it up from the binary. -->
    <ApplicationIcon>Resources\counterpick.ico</ApplicationIcon>
    <!-- The Vite frontend lives beside this project and is built into it. -->
    <WebDir>$(MSBuildProjectDirectory)\..\Counterpick.Web</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also packed as a WPF resource so MainWindow.xaml can name it in Icon="...". -->
    <Resource Include="Resources\counterpick.ico" />
    <AssemblyMetadata Include="UpdateSource" Value="$(UpdateSource)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.47.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A snapshot of the champion play-rate feed (Meraki Analytics championrates.json), so
      enemy roles can be inferred on a first run with no network. The live feed is
      fetched and cached by Services/RoleRates.cs; refresh this copy now and then.
    -->
    <EmbeddedResource Include="Resources\championrates.json" />
  </ItemGroup>

  <!--
    Frontend build.

    Coming from C#: this is the one extra step compared to a plain WPF project.
    `npm run build` compiles the TypeScript in ../Counterpick.Web into plain JS
    and writes it to that project's dist/ folder. Running it from MSBuild means
    `dotnet build` still does everything - you never have to run npm by hand.

    Skip it with:  dotnet build -p:SkipFrontend=true
  -->
  <Target Name="RestoreFrontend" BeforeTargets="BuildFrontend" Condition="'$(SkipFrontend)' != 'true' AND !Exists('$(WebDir)\node_modules')">
    <Message Importance="high" Text="Counterpick: installing frontend packages (first run only)..." />
    <Exec Command="npm install" WorkingDirectory="$(WebDir)" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(SkipFrontend)' != 'true'">
    <Message Importance="high" Text="Counterpick: building frontend..." />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>

  <!--
    Copy the built frontend next to the exe as wwwroot/. WebView2 serves it from
    there under a virtual https:// host - see MainWindow.xaml.cs.

    The item group sits inside the target on purpose: dist/ does not exist yet
    when MSBuild evaluates the project file, so a wildcard out here would match
    nothing on a clean checkout.
  -->
  <Target Name="CopyFrontend" AfterTargets="Build" Condition="'$(SkipFrontend)' != 'true'">
    <ItemGroup>
      <FrontendFile Include="$(WebDir)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFile)" DestinationFiles="@(FrontendFile->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishFrontend" AfterTargets="Publish" Condition="'$(SkipFrontend)' != 'true'">
    <ItemGroup>
      <FrontendFile Include="$(WebDir)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFile)" DestinationFiles="@(FrontendFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
