<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Counterpick.DataTests</RootNamespace>
    <!-- Run with: dotnet run (from this folder), or from the repo root with the
         project flag pointing at tests/Counterpick.DataTests -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Compile the real service sources rather than referencing the app: Counterpick.App
      targets net10.0-windows and pulls in WPF, which a console test host should not.
      Bridge.cs is the only service that needs WebView2, so it stays out.
    -->
    <Compile Include="..\..\src\Counterpick.App\Services\AppPaths.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\Storage.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\BriefCache.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\BackupService.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\DataTransfer.cs" />
    <!-- The pure half of the League client listener: parsing and mapping, no sockets. -->
    <Compile Include="..\..\src\Counterpick.App\Services\ChampionCatalog.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\Lcu\LcuEndpoint.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\Lcu\DraftMapper.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\Lcu\LiveGame.cs" />
    <!-- Enemy role inference: the play-rate table and the pure placement. -->
    <Compile Include="..\..\src\Counterpick.App\Services\RoleRates.cs" />
    <Compile Include="..\..\src\Counterpick.App\Services\RoleInference.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Champ select payloads captured from a live client, identifiers scrubbed. -->
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bundled play-rate snapshot, so the inference is tested on the real table. -->
    <None Include="..\..\src\Counterpick.App\Resources\championrates.json" Link="fixtures\championrates.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
